      "digest": "3da69651e618d617a67c7f17d1f76d6fa542c690b69ae2882823946e0e3342d4",
      "roles": [
        {
          "description": "Crie sprites originais em pixel art 2D para seus seis heróis, os dois Gêmeos como entidades simultâneas, cavaleiros do Quartel, três guardas da Invocação Emergencial e aliados do Invocador, com silhuetas distintas e animações funcionais de movimento, ataque, habilidade, dano e derrota.",
          "id": "heroes_units",
          "label": "Seus seis heróis e unidades aliadas"
        },
        {
          "description": "Crie sprites originais em pixel art 2D para seus sete arquétipos inimigos e os quatro chefes, distinguindo terrestres, voadores, regeneração, ataques à distância e propriedades especiais, com animações legíveis de entrada, movimento, ataque, habilidade, dano e derrota.",
          "id": "enemies_bosses",
          "label": "Seus inimigos e quatro chefes"
        },
        {
          "description": "Crie o castelo e as seis estruturas colocáveis em pixel art 2D, incluindo estados selecionados, danificados e melhorados com mudança visual clara, além das unidades associadas, sem usar símbolos, círculos coloridos ou formas provisórias como arte final.",
          "id": "structures_castle",
          "label": "Seu castelo e suas seis estruturas"
        },
        {
          "description": "Crie cenários em camadas para Caminho da Serpente, Ponte do Cerco, Ilhas Celestes e Floresta Amaldiçoada, com rotas terrestres e aéreas, curvas, obstáculos e espaços de construção visualmente inequívocos, preservando leitura em telas pequenas.",
          "id": "maps_routes",
          "label": "Seus quatro campos de batalha"
        },
        {
          "description": "Crie flechas, tiros de canhão, gelo, eletricidade, magia, meteoros e os cinco feitiços manuais com marcação de área, impacto, duração, recarga e feedback visual próprios; use partículas contidas, luz em pixels e animações ligadas aos estados reais.",
          "id": "projectiles_spells",
          "label": "Seus projéteis, feitiços e efeitos de combate"
        },
        {
          "description": "Crie a apresentação escura com partículas douradas, o logotipo de impacto, avatares internos e o menu do reino em pixel art 2D, com estados de bloqueio, seleção e disponibilidade claramente desenhados e sem ações meramente decorativas.",
          "id": "menus_profile",
          "label": "Sua introdução, perfil e menu do reino"
        },
        {
          "description": "Crie HUD, cartões, barras e controles legíveis para vida, ouro, onda, chefe, velocidade, seleção, construção, melhorias, habilidades e feitiços, com botões amplos para toque e mouse e estados desabilitados inequívocos.",
          "id": "battle_hud",
          "label": "Sua interface de batalha responsiva"
        },
        {
          "description": "Garanta animações e feedback para bloqueio, investida, perfuração, combo, empurrão, provocação, lentidão, congelamento, regeneração, saltos elétricos, escudos quebráveis, antiaéreo, dano ao castelo, entrada de chefe, vitória e derrota.",
          "id": "combat_states",
          "label": "Seus estados visuais e animações de gameplay"
        },
        {
          "description": "Crie telas funcionais para heróis, estruturas, feitiços, mapas, aventura, estatísticas, configurações, loja e resultados, mostrando custos, atributos, recargas, requisitos, recordes, recompensas e confirmações com leitura clara em Android e computador.",
          "id": "results_progression",
          "label": "Suas telas de progressão e resultados"
        },
        {
          "description": "Mantenha em todos os elementos sua paleta limitada, pixels nítidos sem borrão, iluminação em pixels, escala coerente, contornos e silhuetas legíveis; não use emojis, símbolos abstratos, círculos coloridos nem placeholders como arte final.",
          "id": "pixel_style_system",
          "label": "Sua linguagem visual unificada em pixel art"
        }
      ]
    },
